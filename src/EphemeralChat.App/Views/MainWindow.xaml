<Window x:Class="EphemeralChat.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="640"
        Height="480"
        MinWidth="480"
        MinHeight="360">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LocalPeerDescription}" Foreground="Gray" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 HorizontalContentAlignment="Stretch" />

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right"
                    Content="Send"
                    Command="{Binding SendCommand}"
                    Padding="16,4"
                    Margin="8,0,0,0" />
            <TextBox Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Padding="4" />
        </DockPanel>
    </Grid>
</Window>
